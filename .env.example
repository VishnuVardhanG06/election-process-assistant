# ─── Google APIs ───────────────────────────────────────────
# Google Civic Information API key (no OAuth needed)
GOOGLE_CIVIC_API_KEY=your_google_civic_api_key_here

# Google Maps JavaScript API key (restrict to your domain in Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── Google OAuth 2.0 (Calendar + Drive) ──────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ─── NextAuth ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
